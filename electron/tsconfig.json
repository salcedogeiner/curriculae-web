{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["./**/*.mjs", "./**/*.cjs"],
  "exclude": ["./**/*.test.mjs", "./vitest.config.mjs"]
}
